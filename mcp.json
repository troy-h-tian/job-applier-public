{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280,1600",
        "--output-dir",
        "data/screenshots",
        "--secrets",
        "data/.secrets.env"
      ]
    },
    "applier": {
      "command": "python3",
      "args": [
        "scripts/applier_mcp.py"
      ],
      "env": {
        "DATA_REPO_TOKEN": "${DATA_REPO_TOKEN:-}",
        "DATA_REPO": "${DATA_REPO:-}",
        "GITHUB_API_URL": "${GITHUB_API_URL:-https://api.github.com}"
      }
    }
  }
}
